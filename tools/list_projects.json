{
  "name": "list_projects",
  "title": "List projects",
  "description": "Lists the project folders in the user's Meerkat workspace, most recently updated first. Takes an optional limit (1 to 50, default 20). Returns each project's id, name, description and last-updated time. When the user has no projects, returns an empty list and a note saying so. Read-only.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 50,
        "description": "Optional. Max projects to return. Defaults to 20."
      }
    },
    "additionalProperties": false,
    "$schema": "http://json-schema.org/draft-07/schema#"
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "projects": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "description": {
              "type": [
                "string",
                "null"
              ]
            },
            "updatedAt": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "name",
            "description",
            "updatedAt"
          ],
          "additionalProperties": false
        }
      },
      "note": {
        "type": "string",
        "description": "Present only when the user has no projects. States that in plain text."
      }
    },
    "required": [
      "projects"
    ],
    "additionalProperties": false,
    "$schema": "http://json-schema.org/draft-07/schema#"
  },
  "annotations": {
    "title": "List projects",
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
  },
  "execution": {
    "taskSupport": "forbidden"
  }
}
