{
  "name": "search_shelf",
  "title": "Search shelf",
  "description": "Searches the user's saved prompts on their Meerkat shelf for text in the title or body (case-insensitive substring). Archived prompts are excluded. Takes a query, an optional limit (1 to 20, default 5) and an optional project id to search within. Returns matching prompts, most recent first, each with its full text, title, project id, last-updated time and a link to it on getmeerkat.dev. When nothing matches, returns an empty list and a note saying whether the shelf has no saved prompts or the query matched none. Read-only.",
  "inputSchema": {
    "type": "object",
    "properties": {
      "query": {
        "type": "string",
        "minLength": 1,
        "description": "Text to look for in prompt titles and bodies. Case-insensitive substring; queries of 1 to 4 words match best."
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 20,
        "description": "Optional. Max results. Defaults to 5."
      },
      "project_id": {
        "type": "string",
        "description": "Optional. A project id; limits the search to that project."
      }
    },
    "required": [
      "query"
    ],
    "additionalProperties": false,
    "$schema": "http://json-schema.org/draft-07/schema#"
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "results": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "prompt": {
              "type": "string"
            },
            "useCaseTitle": {
              "type": [
                "string",
                "null"
              ]
            },
            "approachTitle": {
              "type": [
                "string",
                "null"
              ]
            },
            "projectId": {
              "type": [
                "string",
                "null"
              ]
            },
            "updatedAt": {
              "type": "string"
            },
            "shelfUrl": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "title",
            "prompt",
            "useCaseTitle",
            "approachTitle",
            "projectId",
            "updatedAt",
            "shelfUrl"
          ],
          "additionalProperties": false
        }
      },
      "note": {
        "type": "string",
        "description": "Present only when results is empty. Says whether the shelf has no saved prompts or the query matched none."
      }
    },
    "required": [
      "results"
    ],
    "additionalProperties": false,
    "$schema": "http://json-schema.org/draft-07/schema#"
  },
  "annotations": {
    "title": "Search shelf",
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
  },
  "execution": {
    "taskSupport": "forbidden"
  }
}
